{
  "name": "imscp/imscp-frontend",
  "description": "i-MSCP frontEnd",
  "type": "project",
  "keywords": [
    "i-MSCP",
    "frontend",
    "PHP"
  ],
  "homepage": "https://wwww.i-mscp.net/",
  "license": "LGPL-2.1-only",
  "authors": [
    {
      "name": "Laurent Declercq",
      "email": "l.declercq@nuxwin.com",
      "homepage": "https://www.i-mscp.net/"
    }
  ],
  "support": {
    "issues": "https://youtrack.i-mscp.net/issues",
    "source": "https://github.com/i-MSCP/imscp",
    "forum": "https://wwww.i-mscp.net/"
  },
  "config": {
    "sort-packages": true,
    "discard-changes": true,
    "htaccess-protect": false,
    "optimize-autoloader": true,
    "apcu-autoloader": true,
    "classmap-authoritative": false,
    "preferred-install": "dist",
    "process-timeout": 5000,
    "use-include-path": false,
    "allow-plugins": {
      "cweagans/composer-patches": true,
      "imscp/composer-installers": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "composer/imscp-composer-installers",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "composer/imscp-elfinder",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "composer/imscp-phpmyadmin",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "composer/imscp-roundcube",
      "options": {
        "symlink": false
      }
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-apcu": "*",
    "ext-bz2": "*",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-date": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-ftp": "*",
    "ext-gd": "*",
    "ext-gettext": "*",
    "ext-gmp": "*",
    "ext-iconv": "*",
    "ext-imap": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pcre": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-phar": "*",
    "ext-posix": "*",
    "ext-reflection": "*",
    "ext-session": "*",
    "ext-simplexml": "*",
    "ext-sockets": "*",
    "ext-sodium": "*",
    "ext-spl": "*",
    "ext-xml": "*",
    "ext-xmlreader": "*",
    "ext-xmlwriter": "*",
    "ext-zip": "*",
    "ext-zlib": "*",
    "algo26-matthias/idna-convert": "^4.0",
    "cweagans/composer-patches": "~1.7.3",
    "imscp/composer-installers": "^1.1",
    "league/flysystem": "^1.1",
    "pear/net_dns2": "~1.5.3",
    "phpseclib/phpseclib": "~2.0.47",
    "slim/slim": "^3.12.6",
    "laminas/laminas-escaper": "^2.13",
    "pedropanos/zf1-future": "^1.25"
  },
  "autoload": {
    "psr-4": {
      "iMSCP\\Plugin\\": "plugins/",
      "iMSCP\\": "src/"
    },
    "files": [
      "include/BcAutoload.php",
      "include/Admin.php",
      "include/Client.php",
      "include/Counting.php",
      "include/Email.php",
      "include/Input.php",
      "include/Intl.php",
      "include/Layout.php",
      "include/Login.php",
      "include/Reseller.php",
      "include/Shared.php",
      "include/Statistics.php",
      "include/View.php"
    ]
  },
  "extra": {
    "installer-paths": {
      "vendor/{$vendor}/{$name}": [
        "imscp/elfinder",
        "imscp/phpmyadmin",
        "imscp/roundcube"
      ]
    },
    "composer-exit-on-patch-failure": true,
    "patches": {
      "pedropanos/zf1-future": {
        "Patch for Zend_Navigation component (isActive() implementation for URI page)": "patches/003_zend_navigation_patch"
      }
    }
  }
}
