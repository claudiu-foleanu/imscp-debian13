#!/bin/sh
# Hourly update of the {CHANNEL} SpamAssassin ruleset
# Auto-generated by the i-MSCP SpamAssassin plugin
#     DO NOT EDIT THIS FILE BY HAND -- YOUR CHANGES WILL BE OVERWRITTEN

test -x /usr/bin/sa-update || exit 0

# Sleep for up to {SLEEP_TIMER} seconds if not running interactively
if [ ! -t 0 ] && [ {SLEEP_TIMER} -gt 0 ]; then
    number=$(od -vAn -N2 -tu4 < /dev/urandom)
    sleep $(( number % {SLEEP_TIMER} ))
fi

umask 022

# The channel isn't GPG signed with a key known by sa-update, hence --nogpg
env -i LANG="$LANG" PATH="$PATH" http_proxy="$http_proxy" https_proxy="$https_proxy" \
    runuser -u {SPAMD_USER} -- /usr/bin/sa-update --nogpg --channel {CHANNEL} 2>&1

case $? in
    0)
        # Got updates. Make sure that the ruleset is valid
        if ! env -i LANG="$LANG" PATH="$PATH" runuser -u {SPAMD_USER} -- /usr/bin/spamassassin --lint >/dev/null 2>&1; then
            echo "spamassassin --lint failed after update of the {CHANNEL} ruleset" >&2
            exit 1
        fi

        # Compile the rules if sa-compile is available
        if command -v re2c >/dev/null 2>&1 && [ -x /usr/bin/sa-compile ]; then
            env -i LANG="$LANG" PATH="$PATH" runuser -u {SPAMD_USER} -- /usr/bin/sa-compile --quiet >/dev/null 2>&1
            [ -d {SPAMD_HOMEDIR}/compiled ] && runuser -u {SPAMD_USER} -- chmod -R go-w,go+rX {SPAMD_HOMEDIR}/compiled
        fi

        # Reload spamd
        if [ -d /run/systemd/system ]; then
            systemctl try-reload-or-restart {SPAMD_SERVICE}.service >/dev/null 2>&1 || true
        fi
        ;;
    1)
        # No updates
        exit 0
        ;;
    *)
        echo "sa-update failed for the {CHANNEL} channel" >&2
        exit 1
        ;;
esac

exit 0
